# Copy to .env (gitignored). Read by the Python scripts and docker-compose.yml.

# Google Gemini — scripts/ingest_knowledge_base.py (use a free-tier key)
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant — scripts/ingest_knowledge_base.py, scripts/backup_qdrant.py
# Default: the local docker-compose Qdrant (no API key).
# Qdrant Cloud: https://<cluster-id>.<region>.gcp.cloud.qdrant.io:6333 plus QDRANT_API_KEY.
# Warning: ingest_knowledge_base.py deletes and recreates the collection — back up first.
QDRANT_HOST=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=voltshop_kb

# Load tests — scripts/load_test_*.py (defaults to the production chat webhook if unset)
VOLTSHOP_WEBHOOK_URL=https://your-n8n-host/webhook/ce7fb03a-8189-4574-b0fd-8cb1edbd5b09

# Local n8n — docker-compose.yml
N8N_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.app
N8N_ENCRYPTION_KEY=your_n8n_encryption_key_here

# Reference only — these are NOT read from .env. Enter them as n8n credentials in the n8n UI.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL_ID=C0AG97YAYP2
SHOPIFY_STORE_URL=https://your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token_here
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
GMAIL_CLIENT_ID=your_gmail_client_id_here
GMAIL_CLIENT_SECRET=your_gmail_client_secret_here
